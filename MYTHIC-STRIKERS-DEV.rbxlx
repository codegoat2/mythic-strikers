	},
	{
		Id          = "GEAR_BALL_SOLAR",
		Name        = "Solar Ball Skin",
		ShopType    = "GearShop",
		Price       = 200,
		Currency    = "Coins",
		Description = "The ball glows like a miniature sun.",
		Tier        = "Rare",
		Tags        = { "Gear", "Ball", "Fire" },
	},
	{
		Id          = "GEAR_BALL_COSMIC",
		Name        = "Cosmic Ball Skin",
		ShopType    = "GearShop",
